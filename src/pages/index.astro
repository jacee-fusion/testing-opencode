<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Testing Opencode Project</title>
		<style>
			:root {
				--bg: #0b0b12;
				--text: #f4f4f6;
				--muted: #a7a7b8;
				--accent-start: #7c6cff;
				--accent-end: #38e1c6;
			}
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
			body {
				font-family:
					system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
				background: var(--bg);
				color: var(--text);
				min-height: 100vh;
			}
			.hero {
				position: relative;
				overflow: hidden;
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 100vh;
				padding: 4rem 1.5rem;
				text-align: center;
			}
			.hero::before,
			.hero::after {
				content: "";
				position: absolute;
				border-radius: 50%;
				filter: blur(120px);
				opacity: 0.45;
				pointer-events: none;
			}
			.hero::before {
				width: 34rem;
				height: 34rem;
				top: -12rem;
				left: -10rem;
				background: var(--accent-start);
			}
			.hero::after {
				width: 30rem;
				height: 30rem;
				bottom: -12rem;
				right: -8rem;
				background: var(--accent-end);
				opacity: 0.3;
			}
			.hero-inner {
				position: relative;
				max-width: 46rem;
			}
			.badge {
				display: inline-block;
				padding: 0.4rem 1rem;
				margin-bottom: 1.5rem;
				font-size: 0.8rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--text);
				border: 1px solid rgba(255, 255, 255, 0.18);
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.06);
				backdrop-filter: blur(6px);
			}
			h1 {
				font-size: clamp(2.5rem, 7vw, 4.5rem);
				line-height: 1.1;
				letter-spacing: -0.02em;
				font-weight: 800;
			}
			h1 .gradient {
				background: linear-gradient(
					90deg,
					var(--accent-start),
					var(--accent-end)
				);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			.sub {
				margin: 1.25rem auto 0;
				max-width: 34rem;
				font-size: 1.125rem;
				line-height: 1.7;
				color: var(--muted);
			}
			.actions {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-top: 2.25rem;
			}
			.btn {
				display: inline-block;
				padding: 0.85rem 1.9rem;
				font-size: 1rem;
				font-weight: 600;
				text-decoration: none;
				border-radius: 999px;
				transition:
					transform 0.15s ease,
					box-shadow 0.15s ease,
					background 0.15s ease;
			}
			.btn:hover {
				transform: translateY(-2px);
			}
			.btn-primary {
				color: #0b0b12;
				background: linear-gradient(
					90deg,
					var(--accent-start),
					var(--accent-end)
				);
				box-shadow: 0 8px 30px rgba(124, 108, 255, 0.35);
			}
			.btn-ghost {
				color: var(--text);
				border: 1px solid rgba(255, 255, 255, 0.22);
				background: rgba(255, 255, 255, 0.04);
			}
			.btn-ghost:hover {
				background: rgba(255, 255, 255, 0.1);
			}
		</style>
	</head>
	<body>
		<section class="hero">
			<div class="hero-inner">
				<span class="badge">Welcome</span>
				<h1>
					Testing <span class="gradient">Opencode</span> Project
				</h1>
				<p class="sub">
					A simple starting point built with Astro — fast, modern,
					and ready to grow with your ideas.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="#get-started">Get Started</a>
					<a
						class="btn btn-ghost"
						href="https://github.com/jacee-fusion/testing-opencode"
						target="_blank"
						rel="noreferrer"
					>
						View on GitHub
					</a>
				</div>
			</div>
		</section>
	</body>
</html>
